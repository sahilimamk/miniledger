# MiniLedger server environment (copy to .env)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/miniledger
# Used by the test suite (vitest) instead of DATABASE_URL
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/miniledger_test
PORT=4000
# Dev-only default is built in; set a real secret outside local development.
JWT_SECRET=dev-only-secret-change-me
